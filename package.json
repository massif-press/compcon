{
  "name": "compcon",
  "private": true,
  "version": "3.0.9",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-nocheck": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --fix",
    "lint:check": "eslint src/",
    "format": "prettier --write 'src/**/*.{ts,vue,json,css,scss,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,vue,json,css,scss,md}'",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ledger": "node scripts/test-ledger.mjs",
    "test:mutation": "stryker run",
    "test:mutation:file": "stryker run --mutate",
    "locales": "node scripts/locales.mjs",
    "build:lcp-script": "esbuild scripts/build-llp.mjs --bundle --platform=node --format=esm --external:jszip --legal-comments=none --banner:js=\"$(sed -n '/^\\/\\*!/,/^\\*\\//p' scripts/build-llp.mjs)\" --outfile=build-lcp.mjs",
    "prepare": "husky",
    "check:print": "node scripts/check-print-consistency.mjs"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ],
    "src/{features/pilot_management/Print,features/gm/*/print,ui/components/print,ui/print,shared/print}/**/*.{ts,vue}": [
      "node scripts/check-print-consistency.mjs"
    ]
  },
  "dependencies": {
    "@kyvg/vue3-notification": "3.4.2",
    "@massif/lancer-data": "^4.0.11",
    "@mdi/font": "7.4.47",
    "@sentry/vite-plugin": "^5.1.1",
    "@sentry/vue": "^10.40.0",
    "@vueup/vue-quill": "^1.2.0",
    "aws-amplify": "6.16.2",
    "chart.js": "4.5.1",
    "chartjs-plugin-annotation": "3.1.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "dompurify": "^3.3.1",
    "expr-eval": "^2.0.2",
    "jszip": "3.10.1",
    "localforage": "1.10.0",
    "lodash-es": "^4.17.23",
    "marked": "^15.0.12",
    "pinia": "3.0.4",
    "quill": "^2.0.2",
    "semver": "7.7.4",
    "sortablejs": "^1.15.7",
    "sortablejs-vue3": "^1.3.0",
    "typeit": "^8.8.7",
    "vue": "3.5.29",
    "vue-advanced-cropper": "2.8.9",
    "vue-chartjs": "5.3.3",
    "vue-html-secure": "^1.0.10",
    "vue-i18n": "^11",
    "vue-router": "4.6.4",
    "vuetify": "^3.12.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@pinia/testing": "1.0.3",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.19.11",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.1.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "1.97.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.3",
    "vite-plugin-purgecss": "^0.2.13",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.0",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "2.2.12",
    "yaml-eslint-parser": "^2.0.0"
  },
  "resolutions": {
    "quill": "^2.0.2",
    "@vue/server-renderer": "^3.x",
    "@vue/compiler-ssr": "^3.x"
  },
  "packageManager": "yarn@4.13.0"
}
